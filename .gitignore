# Datos personales de alumnos (RUT, correo). El roster real nunca se versiona;
# el ejemplo con encabezados sí. Ver assignment-preparation/AGENTS.md.
**/roster/*.csv
!**/roster/roster_example.csv

# Configuración de un curso concreto (organización, template, team reales).
# Solo se versiona la plantilla documentada.
course.toml
course.*.toml
!course.example.toml

# Salidas de ejecución
logs/
state/

# Evaluación: los clones traen el código de los alumnos y las minutas de
# revisión hablan de personas identificadas. Ninguno de los dos se versiona.
clones/
output/

__pycache__/
*.pyc
.DS_Store

# Correos a estudiantes (assignment-mailings): las bases de datos de mailmerge
# traen correos y, a veces, credenciales que se entregan a los alumnos. Solo se
# versionan las plantillas y los .keep. Los envíos quedan registrados en logs/.
assignment-mailings/data/*
!assignment-mailings/data/.keep
assignment-mailings/.venv/
